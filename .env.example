# Copy to .env and fill in. .env is gitignored.
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides
# SCHEMA_VOYAGER_MODEL=claude-sonnet-5-5
# SCHEMA_VOYAGER_EFFORT=medium

# Crusoe Managed Inference (OpenAI-compatible) instead of Claude, for every system.
# Check the model id with: curl -H "Authorization: Bearer $CRUSOE_API_KEY" <base url>/models
# SCHEMA_VOYAGER_PROVIDER=crusoe
# CRUSOE_API_KEY=...
# SCHEMA_VOYAGER_BASE_URL=https://api.inference.crusoecloud.com/v1
# SCHEMA_VOYAGER_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
# BOT_API_URL=http://127.0.0.1:3000
# RCON_PASSWORD=schemavoyager
